# step 7: message log follows, Up parks it, back at the end it follows again
key alt+l
wait Message Log
key f5
wait burst 40
snap step-07a-follows
key up*3
key f5
snap step-07b-parked
key end
key f5
wait burst 120
snap step-07c-follows-again
key esc

# step 8: terminal, settings, plugin manager, markdown preview open and close on an outside click
key alt+t
wait qed$
snap step-08a-terminal
click 0 0
snap step-08b-terminal-closed
key ctrl+p
type settings open
key enter
wait Options
snap step-08c-settings
click 0 0
snap step-08d-settings-closed
key ctrl+p
type plugin manager open
key enter
wait Layout
wait Burst
click 0 0
snap step-08f-plugins-closed
