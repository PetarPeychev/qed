# Acceptance: the whole manual checklist in one recording, an assertion and a golden snap after every step.
requires clangd rg
size 160x45
timeout 15000
config
{"lsp": {"enabled": true}, "line_wrap": false}
end
home-file .config/qed/plugins/burst/init.lua
local count = 0
return {setup = function()
	qed.command{name = "Burst", key = "F5", run = function()
		for _ = 1, 40 do
			count = count + 1
			qed.log(("burst %02d"):format(count))
		end
	end}
end}
end
