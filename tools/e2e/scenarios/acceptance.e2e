run notes.txt
wait alpha beta gamma

# step 1: type, save, undo, paragraph jumps, double and triple click
type X
key ctrl+s
expect-file notes.txt
Xalpha beta gamma
second line here

third para start
more para text

last para
end
key ctrl+z
wait 1/8
snap step-01a-saved-undone
key ctrl+down
snap step-01b-paragraph-down
key ctrl+down ctrl+up
snap step-01c-paragraph-up
dclick 10 0
snap step-01d-word
dclick 10 1
click 10 1
snap step-01e-line
key shift+down shift+down

# step 2: palette, a pasted multi-line string becomes one line, arrows, Enter runs
key ctrl+c
key ctrl+p
wait Ctrl+w
key ctrl+v
snap step-02a-pasted-one-line
key ctrl+a
type line wrap
key down up
snap step-02b-filtered
key enter
wait Line wrap: on
snap step-02c-ran

# step 3: find, step, replace, Esc
key ctrl+f
type para
key enter
snap step-03a-found
key ctrl+h
type PARA
key enter
snap step-03b-replaced
key esc
wait more PARA text
snap step-03c-closed

# step 4: file tree filter previews at once, Shift+Down range, drag select
key alt+f
wait notes.txt
type bravo
wait bravo file body
snap step-04a-filter-preview
key backspace*5
key down shift+down shift+down
snap step-04b-range
drag 12 8 12 10
snap step-04c-drag
key esc

# step 5: go to line on a large file, project search, open directory
key alt+f
type big.txt
key enter
wait line 1 with
key ctrl+g
type 2500
key enter
wait line 2500 with
snap step-05a-goto
key alt+F
type charlie file
wait charlie.txt:1
snap step-05b-search
key enter
wait charlie file body
key ctrl+o
wait proj
snap step-05c-open-directory
type proj
key tab
key enter
wait Close
snap step-05d-unsaved-confirm
key down enter
wait Working directory

# step 6: LSP completion, hover with wheel, diagnostic, wheel closes completion
