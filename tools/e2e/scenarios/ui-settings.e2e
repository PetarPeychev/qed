# Settings menu on qed.ui: filter, toggle a bool, number prompt, Tab/Shift+Tab tabs, chord capture, the open chord toggles.
config
{"lsp": {"enabled": false}}
end
home-file .config/qed/keybinds.json
{"settings": {"open_config_ui": "Alt+k"}}
end
file a.txt
x
end
run a.txt
wait x
key ctrl+p
type settings open config ui
key enter
wait auto_close_pairs
type line_wrap
wait Soft wrap
key enter
wait line_wrap set to false
snap toggled
key ctrl+a
type tab_width
wait Display width
key enter
wait tab_width: 4
snap prompt
key esc
key tab
wait Chord
snap keybinds Tab switches to the Keybinds tab
key shift+tab
wait Value
snap options Shift+Tab switches back to Options
key tab
wait Chord
key ctrl+a
type toggle line wrap
key enter
wait Press a chord
snap chord
key esc esc esc
snap closed
key alt+k
wait type to filter
snap reopened Alt+k opens the menu
key alt+k
wait Spaces
snap toggled-closed Alt+k again closes it
