# Welcome screen on a directory, the file tree, Tab/Shift+Tab between its tabs, open a file from it.
file src/app.py
def main():
    print("hi")
end
file src/util.py
X = 1
end
file README.md
# demo
end
file notes.txt
todo
end
run
wait qed dev
snap welcome
key alt+f
wait README.md
snap tree
key tab
wait Tab tabs
snap open-tab Tab switches to the Open tab
key shift+tab
wait README.md
snap all-tab Shift+Tab switches back to All
key enter
wait app.py
snap expanded
key down
key enter
wait def main
snap opened
