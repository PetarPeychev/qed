{
  "scroll_margin": 3,
  "tab_width": 4,
  "wheel_scroll_lines": 3,
  "double_click_ms": 400,
  "cursor_accel_interval_ms": 55,
  "cursor_accel_ramp_presses": 20,
  "cursor_accel_max_step": 6,
  "picker_width": 64,
  "picker_max_rows": 8,
  "pane_max_width": 120,
  "preview_diff_context": 3,
  "alt_esc_timeout_ms": 25,
  "jump_threshold": 10,
  "big_file_bytes": 2097152,
  "split_tree_min_width": 30,
  "split_tree_max_width": 60,
  "split_code_min_width": 50,
  "split_code_max_width": 100,
  "plugin_memory_mb": 256,
  "plugin_hook_timeout_ms": 2000,
  "plugin_slice_max_ms": 1000,
  "plugin_command_max_ms": 5000,
  "cursor_accel": true,
  "auto_close_pairs": true,
  "line_wrap": true,
  "diff_view": false,
  "image_protocol": "auto",
  "image_max_rows": 24,
  "lsp": {
    "enabled": true,
    "completion_max_rows": 8,
    "completion_min_chars": 1,
    "hover_max_width": 120
  },
  "plugins": {
    "ai": {
      "enabled": true
    },
    "conflict": {
      "enabled": true
    },
    "filetree": {
      "enabled": true
    },
    "find": {
      "enabled": true
    },
    "format": {
      "enabled": true
    },
    "git": {
      "enabled": true
    },
    "goto": {
      "enabled": true
    },
    "layout": {
      "enabled": true
    },
    "log": {
      "enabled": true
    },
    "markdown": {
      "enabled": true
    },
    "palette": {
      "enabled": true
    },
    "settings": {
      "enabled": true
    },
    "terminal": {
      "enabled": true
    },
    "dialog": {
      "enabled": true
    },
    "manager": {
      "enabled": true
    },
    "search": {
      "enabled": true
    },
    "workspace": {
      "enabled": true
    }
  },
  "theme": "default",
  "keybinds": {
    "Command Palette": "Ctrl+p",
    "Go to: Start of File": "Alt+{",
    "Go to: End of File": "Alt+}",
    "Jump Back": "Alt+,",
    "Jump Forward": "Alt+.",
    "Close Buffer": "Ctrl+w",
    "Save": "Ctrl+s",
    "Quit": "Ctrl+q",
    "Undo": "Ctrl+z",
    "Redo": "Ctrl+y",
    "Cut": "Ctrl+x",
    "Copy": "Ctrl+c",
    "Paste": "Ctrl+v",
    "Select All": "Ctrl+a",
    "Toggle Comment": "Ctrl+/",
    "LSP: Go to Definition": "Alt+d",
    "LSP: Hover": "Alt+s",
    "LSP: Rename Symbol": "Alt+r",
    "Git: Toggle Diff View": "",
    "Git: Next Change": "Alt+'",
    "Git: Previous Change": "Alt+;",
    "Git: Revert Hunk": "Alt+z",
    "Toggle Line Wrap": "",
    "LSP: Next Diagnostic": "Alt+>",
    "LSP: Previous Diagnostic": "Alt+<",
    "LSP: Restart": "",
    "Debug: Inspect Tokens": "",
    "Editor: Left": "Left",
    "Editor: Right": "Right",
    "Editor: Up": "Up",
    "Editor: Down": "Down",
    "Editor: Select Left": "Shift+Left",
    "Editor: Select Right": "Shift+Right",
    "Editor: Select Up": "Shift+Up",
    "Editor: Select Down": "Shift+Down",
    "Editor: Word Left": "Ctrl+Left",
    "Editor: Word Right": "Ctrl+Right",
    "Editor: Line Start": "Alt+Left",
    "Editor: Line End": "Alt+Right",
    "Editor: Paragraph Up": "Ctrl+Up",
    "Editor: Paragraph Down": "Ctrl+Down",
    "Editor: Select Word Left": "Ctrl+Shift+Left",
    "Editor: Select Word Right": "Ctrl+Shift+Right",
    "Editor: Select Line Start": "Alt+Shift+Left",
    "Editor: Select Line End": "Alt+Shift+Right",
    "Editor: Select Paragraph Up": "Ctrl+Shift+Up",
    "Editor: Select Paragraph Down": "Ctrl+Shift+Down",
    "Editor: Newline": "Enter",
    "Editor: Backspace": "Backspace",
    "Editor: Delete": "Delete",
    "Editor: Indent": "Tab",
    "Editor: Dedent": "Shift+Tab",
    "Editor: Close Inspect": "Esc",
    "List: Next": "Down",
    "List: Previous": "Up",
    "List: Page Down": "PgDn",
    "List: Page Up": "PgUp",
    "List: First": "Home",
    "List: Last": "End",
    "List: Extend Down": "Shift+Down",
    "List: Extend Up": "Shift+Up",
    "Editor: Move Line Up": "Alt+Up",
    "Editor: Move Line Down": "Alt+Down"
  },
  "languages": {
    "odin": {
      "patterns": ["*.odin"],
      "lsp": "ols"
    },
    "c": {
      "patterns": ["*.c", "*.h"],
      "lsp": "clangd"
    },
    "cpp": {
      "patterns": ["*.cpp", "*.cc", "*.cxx", "*.hpp", "*.hh"],
      "lsp": "clangd"
    },
    "javascript": {
      "patterns": ["*.js", "*.mjs", "*.cjs"],
      "lsp": "typescript-language-server --stdio"
    },
    "jsx": {
      "patterns": ["*.jsx"],
      "lsp": "typescript-language-server --stdio"
    },
    "typescript": {
      "patterns": ["*.ts", "*.mts", "*.cts"],
      "lsp": "typescript-language-server --stdio"
    },
    "tsx": {
      "patterns": ["*.tsx"],
      "lsp": "typescript-language-server --stdio"
    },
    "python": {
      "patterns": ["*.py", "*.pyw"],
      "lsp": "pyright-langserver --stdio"
    },
    "go": {
      "patterns": ["*.go"],
      "lsp": "gopls"
    },
    "rust": {
      "patterns": ["*.rs"],
      "lsp": "rust-analyzer"
    },
    "shell": {
      "patterns": ["*.sh", "*.bash", "*.zsh", ".bashrc", ".bash_profile", ".bash_aliases", ".profile", ".zshrc", ".zshenv", ".zprofile", "PKGBUILD"],
      "lsp": "bash-language-server start"
    },
    "lua": {
      "patterns": ["*.lua", ".luacheckrc"],
      "lsp": "lua-language-server"
    },
    "sql": {
      "patterns": ["*.sql"],
      "lsp": ""
    },
    "yaml": {
      "patterns": ["*.yaml", "*.yml"],
      "lsp": "yaml-language-server --stdio"
    },
    "toml": {
      "patterns": ["*.toml"],
      "lsp": "taplo lsp stdio"
    },
    "dockerfile": {
      "patterns": ["Dockerfile", "*.dockerfile", "Dockerfile.*"],
      "lsp": "docker-langserver --stdio"
    },
    "json": {
      "patterns": ["*.json"],
      "lsp": ""
    },
    "html": {
      "patterns": ["*.html", "*.htm"],
      "lsp": "vscode-html-language-server --stdio"
    },
    "css": {
      "patterns": ["*.css"],
      "lsp": "vscode-css-language-server --stdio"
    },
    "markdown": {
      "patterns": ["*.md", "*.markdown"],
      "lsp": ""
    }
  }
}
