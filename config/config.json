{
  "scroll_margin": 3,
  "tab_width": 4,
  "wheel_scroll_lines": 3,
  "double_click_ms": 400,
  "cursor_accel_interval_ms": 55,
  "cursor_accel_ramp_presses": 20,
  "cursor_accel_max_step": 6,
  "palette_max_rows": 8,
  "preview_diff_context": 3,
  "alt_esc_timeout_ms": 25,
  "jump_threshold": 10,
  "big_file_bytes": 2097152,
  "split_tree_min_width": 30,
  "split_tree_max_width": 60,
  "split_code_min_width": 50,
  "split_code_max_width": 100,
  "split_preview_min_width": 70,
  "split_preview_max_width": 130,
  "plugin_memory_mb": 256,
  "plugin_hook_timeout_ms": 2000,
  "plugin_slice_max_ms": 1000,
  "plugin_command_max_ms": 5000,
  "cursor_accel": true,
  "auto_close_pairs": true,
  "line_wrap": true,
  "terminal_escape_closes": true,
  "diff_view": false,
  "message_log_backdrop": "none",
  "plugins_pane_backdrop": "none",
  "lsp": {
    "enabled": true,
    "completion_max_rows": 8,
    "completion_min_chars": 1
  },
  "plugins": {
    "ai": {
      "enabled": true
    },
    "conflict": {
      "enabled": true
    },
    "filetree": {
      "enabled": true
    },
    "format": {
      "enabled": true
    },
    "git": {
      "enabled": true
    },
    "goto": {
      "enabled": true
    },
    "markdown": {
      "enabled": true
    },
    "settings": {
      "enabled": true
    },
    "search": {
      "enabled": true
    },
    "workspace": {
      "enabled": true
    }
  },
  "theme": "default",
  "keybinds": {
    "Command Palette": "Ctrl+p",
    "Terminal: Toggle": "Alt+t",
    "Find": "Ctrl+f",
    "Replace": "Ctrl+h",
    "Go to Start of File": "Alt+{",
    "Go to End of File": "Alt+}",
    "Jump Back": "Alt+,",
    "Jump Forward": "Alt+.",
    "Close Buffer": "Ctrl+w",
    "Save": "Ctrl+s",
    "Quit": "Ctrl+q",
    "Undo": "Ctrl+z",
    "Redo": "Ctrl+y",
    "Cut": "Ctrl+x",
    "Copy": "Ctrl+c",
    "Paste": "Ctrl+v",
    "Select All": "Ctrl+a",
    "Toggle Comment": "Ctrl+/",
    "LSP: Go to Definition": "Alt+d",
    "LSP: Hover": "Alt+s",
    "LSP: Rename Symbol": "Alt+r",
    "Diff: Toggle View": "",
    "Diff: Next Change": "Alt+'",
    "Diff: Previous Change": "Alt+;",
    "Diff: Revert Hunk": "Alt+z",
    "Toggle Line Wrap": "",
    "LSP: Next Diagnostic": "Alt+>",
    "LSP: Previous Diagnostic": "Alt+<",
    "LSP: Restart": "",
    "Debug: Inspect Tokens": "",
    "Message Log: Open": "Alt+l",
    "Plugins: Open": "",
    "Message Log: Toggle Debug": "d",
    "Message Log: Toggle Info": "i",
    "Message Log: Toggle Warn": "w",
    "Message Log: Toggle Error": "e",
    "Message Log: Toggle History": "h",
    "Plugins: Enable/Disable": "e",
    "Plugins: Reload": "r",
    "Plugins: Show Log": "l"
  },
  "languages": {
    "odin": {
      "patterns": ["*.odin"],
      "lsp": "ols"
    },
    "c": {
      "patterns": ["*.c", "*.h"],
      "lsp": "clangd"
    },
    "cpp": {
      "patterns": ["*.cpp", "*.cc", "*.cxx", "*.hpp", "*.hh"],
      "lsp": "clangd"
    },
    "javascript": {
      "patterns": ["*.js", "*.mjs", "*.cjs"],
      "lsp": "typescript-language-server --stdio"
    },
    "jsx": {
      "patterns": ["*.jsx"],
      "lsp": "typescript-language-server --stdio"
    },
    "typescript": {
      "patterns": ["*.ts", "*.mts", "*.cts"],
      "lsp": "typescript-language-server --stdio"
    },
    "tsx": {
      "patterns": ["*.tsx"],
      "lsp": "typescript-language-server --stdio"
    },
    "python": {
      "patterns": ["*.py", "*.pyw"],
      "lsp": "pyright-langserver --stdio"
    },
    "go": {
      "patterns": ["*.go"],
      "lsp": "gopls"
    },
    "rust": {
      "patterns": ["*.rs"],
      "lsp": "rust-analyzer"
    },
    "shell": {
      "patterns": ["*.sh", "*.bash", "*.zsh", ".bashrc", ".bash_profile", ".bash_aliases", ".profile", ".zshrc", ".zshenv", ".zprofile", "PKGBUILD"],
      "lsp": "bash-language-server start"
    },
    "lua": {
      "patterns": ["*.lua", ".luacheckrc"],
      "lsp": "lua-language-server"
    },
    "sql": {
      "patterns": ["*.sql"],
      "lsp": ""
    },
    "yaml": {
      "patterns": ["*.yaml", "*.yml"],
      "lsp": "yaml-language-server --stdio"
    },
    "toml": {
      "patterns": ["*.toml"],
      "lsp": "taplo lsp stdio"
    },
    "dockerfile": {
      "patterns": ["Dockerfile", "*.dockerfile", "Dockerfile.*"],
      "lsp": "docker-langserver --stdio"
    },
    "json": {
      "patterns": ["*.json"],
      "lsp": ""
    },
    "html": {
      "patterns": ["*.html", "*.htm"],
      "lsp": "vscode-html-language-server --stdio"
    },
    "css": {
      "patterns": ["*.css"],
      "lsp": "vscode-css-language-server --stdio"
    },
    "markdown": {
      "patterns": ["*.md", "*.markdown"],
      "lsp": ""
    }
  }
}
