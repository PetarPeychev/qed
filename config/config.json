{
  "scroll_margin": 10,
  "tab_width": 4,
  "wheel_scroll_lines": 3,
  "double_click_ms": 400,
  "disk_poll_ms": 1000,
  "cursor_accel_interval_ms": 55,
  "cursor_accel_ramp_presses": 20,
  "cursor_accel_max_step": 6,
  "palette_width": 60,
  "palette_max_rows": 8,
  "picker_margin_x": 8,
  "picker_margin_y": 3,
  "projsearch_max": 500,
  "projsearch_min_query": 2,
  "preview_max_lines": 4000,
  "preview_parse_ahead": 64,
  "preview_diff_context": 3,
  "alt_esc_timeout_ms": 25,
  "lsp_poll_ms": 30,
  "diag_pane_margin_x": 2,
  "diag_pane_max_lines": 8,
  "completion_debounce_ms": 120,
  "completion_max_rows": 8,
  "completion_max_width": 40,
  "completion_min_chars": 1,
  "jump_threshold": 10,
  "git_diff_max_d": 2000,
  "git_stat_poll_ms": 2000,
  "big_file_bytes": 2097152,
  "format_on_save": false,
  "cursor_accel": true,
  "auto_close_pairs": true,
  "git_diff_view": false,
  "line_wrap": true,
  "filetree_show_dotfiles": false,
  "filetree_show_ignored": false,
  "terminal_escape_closes": true,
  "theme": "default",
  "keybinds": {
    "Open File": "Ctrl+o",
    "File Tree": "Alt+f",
    "Terminal: Toggle": "Alt+t",
    "Find": "Ctrl+f",
    "Replace": "Ctrl+h",
    "Find Line": "Ctrl+g",
    "Find in Files": "Alt+F",
    "Go to Start of File": "Alt+{",
    "Go to End of File": "Alt+}",
    "Jump Back": "Alt+,",
    "Jump Forward": "Alt+.",
    "Switch Buffer": "Alt+e",
    "Close Buffer": "Ctrl+w",
    "Save": "Ctrl+s",
    "Quit": "Ctrl+q",
    "Undo": "Ctrl+z",
    "Redo": "Ctrl+y",
    "Cut": "Ctrl+x",
    "Copy": "Ctrl+c",
    "Paste": "Ctrl+v",
    "Select All": "Ctrl+a",
    "Toggle Comment": "Ctrl+/",
    "Change Indentation": "",
    "Set Language": "",
    "Set Theme": "",
    "LSP: Go to Definition": "Alt+d",
    "LSP: Hover": "Alt+s",
    "LSP: Rename Symbol": "Alt+r",
    "AI: Edit Selection": "Ctrl+k",
    "AI: Cancel Edits": "",
    "AI: Toggle Inline Completion": "",
    "Format Document": "",
    "Toggle Format on Save": "",
    "Git: Toggle Diff View": "Alt+g",
    "Git: Resolve Conflict": "Alt+m",
    "Toggle Line Wrap": "",
    "LSP: Next Diagnostic": "Alt+>",
    "LSP: Previous Diagnostic": "Alt+<",
    "LSP: Restart": "",
    "Debug: Inspect Tokens": ""
  },
  "languages": {
    "odin": {
      "patterns": ["*.odin"],
      "lsp": "ols",
      "formatter": ""
    },
    "c": {
      "patterns": ["*.c", "*.h"],
      "lsp": "clangd",
      "formatter": ""
    },
    "cpp": {
      "patterns": ["*.cpp", "*.cc", "*.cxx", "*.hpp", "*.hh"],
      "lsp": "clangd",
      "formatter": ""
    },
    "javascript": {
      "patterns": ["*.js", "*.mjs", "*.cjs"],
      "lsp": "typescript-language-server --stdio",
      "formatter": ""
    },
    "jsx": {
      "patterns": ["*.jsx"],
      "lsp": "typescript-language-server --stdio",
      "formatter": ""
    },
    "typescript": {
      "patterns": ["*.ts", "*.mts", "*.cts"],
      "lsp": "typescript-language-server --stdio",
      "formatter": ""
    },
    "tsx": {
      "patterns": ["*.tsx"],
      "lsp": "typescript-language-server --stdio",
      "formatter": ""
    },
    "python": {
      "patterns": ["*.py", "*.pyw"],
      "lsp": "pyright-langserver --stdio",
      "formatter": "ruff format -"
    },
    "go": {
      "patterns": ["*.go"],
      "lsp": "gopls",
      "formatter": "gofmt"
    },
    "rust": {
      "patterns": ["*.rs"],
      "lsp": "rust-analyzer",
      "formatter": "rustfmt --edition 2021"
    },
    "shell": {
      "patterns": ["*.sh", "*.bash", "*.zsh", ".bashrc", ".bash_profile", ".bash_aliases", ".profile", ".zshrc", ".zshenv", ".zprofile", "PKGBUILD"],
      "lsp": "bash-language-server start",
      "formatter": ""
    },
    "lua": {
      "patterns": ["*.lua", ".luacheckrc"],
      "lsp": "lua-language-server",
      "formatter": ""
    },
    "sql": {
      "patterns": ["*.sql"],
      "lsp": "",
      "formatter": ""
    },
    "yaml": {
      "patterns": ["*.yaml", "*.yml"],
      "lsp": "yaml-language-server --stdio",
      "formatter": ""
    },
    "toml": {
      "patterns": ["*.toml"],
      "lsp": "taplo lsp stdio",
      "formatter": "taplo fmt -"
    },
    "dockerfile": {
      "patterns": ["Dockerfile", "*.dockerfile", "Dockerfile.*"],
      "lsp": "docker-langserver --stdio",
      "formatter": ""
    },
    "json": {
      "patterns": ["*.json"],
      "lsp": "",
      "formatter": ""
    },
    "html": {
      "patterns": ["*.html", "*.htm"],
      "lsp": "vscode-html-language-server --stdio",
      "formatter": ""
    },
    "css": {
      "patterns": ["*.css"],
      "lsp": "vscode-css-language-server --stdio",
      "formatter": ""
    },
    "markdown": {
      "patterns": ["*.md", "*.markdown"],
      "lsp": "",
      "formatter": ""
    }
  },
  "llm": {
    "chat_command": "claude -p",
    "edit_prompt": "You are editing the file {path}. Its full current content is below, with the region to rewrite marked between <<<SELECT and SELECT>>>. You may read other project files for context and reason briefly first if you need to. Then give the replacement for the marked region — and nothing else — inside a single markdown fenced code block (```). Do not repeat the surrounding code or the markers, and write nothing after the closing fence.\n\nInstruction: {instruction}\n\n{file}",
    "completion_endpoint": "https://codestral.mistral.ai/v1/fim/completions",
    "completion_model": "codestral-latest",
    "completion_api_key_env": "CODESTRAL_API_KEY",
    "completion_max_tokens": 256,
    "completion_debounce_ms": 350,
    "completion_context_lines": 200,
    "completion_enabled": false
  }
}
