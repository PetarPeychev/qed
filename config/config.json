{
  "scroll_margin": 3,
  "tab_width": 4,
  "wheel_scroll_lines": 3,
  "double_click_ms": 400,
  "cursor_accel_interval_ms": 55,
  "cursor_accel_ramp_presses": 20,
  "cursor_accel_max_step": 6,
  "palette_max_rows": 8,
  "projsearch_min_query": 2,
  "preview_diff_context": 3,
  "alt_esc_timeout_ms": 25,
  "jump_threshold": 10,
  "big_file_bytes": 2097152,
  "filetree_list_min_width": 30,
  "filetree_list_max_width": 60,
  "code_list_min_width": 50,
  "code_list_max_width": 100,
  "preview_min_width": 70,
  "preview_max_width": 130,
  "plugin_memory_mb": 64,
  "plugin_hook_timeout_ms": 2000,
  "cursor_accel": true,
  "auto_close_pairs": true,
  "line_wrap": true,
  "filetree_show_dotfiles": false,
  "filetree_show_ignored": false,
  "terminal_escape_closes": true,
  "modules": {
    "git": {
      "enabled": true,
      "diff_view": false,
      "filetree_diff_only": true
    },
    "lsp": {
      "enabled": true,
      "completion_max_rows": 8,
      "completion_min_chars": 1
    },
    "ai": {
      "enabled": true,
      "chat_command": "claude -p",
      "edit_prompt": "You are editing the file {path}. Its full current content is below, with the region to rewrite marked between <<<SELECT and SELECT>>>. You may read other project files for context and reason briefly first if you need to. Then give the replacement for the marked region — and nothing else — inside a single markdown fenced code block (```). Do not repeat the surrounding code or the markers, and write nothing after the closing fence.\n\nInstruction: {instruction}\n\n{file}",
      "completion_endpoint": "https://codestral.mistral.ai/v1/fim/completions",
      "completion_model": "codestral-latest",
      "completion_api_key_env": "CODESTRAL_API_KEY",
      "completion_max_tokens": 256,
      "completion_debounce_ms": 350,
      "completion_context_lines": 200,
      "completion_enabled": false
    }
  },
  "plugins": {
    "format": {
      "enabled": true,
      "format_on_save": false,
      "trim_trailing_whitespace_on_save": false,
      "ensure_final_newline_on_save": false,
      "commands": {
        "python": "ruff format --stdin-filename {file} -",
        "go": "gofmt",
        "rust": "rustfmt --edition 2021",
        "sql": "sql-formatter",
        "toml": "taplo fmt --stdin-filepath {file} -",
        "json": "prettier --parser json --stdin-filepath {file}"
      }
    }
  },
  "theme": "default",
  "keybinds": {
    "Command Palette": "Ctrl+p",
    "File Tree": "Alt+f",
    "File Tree: Open": "Alt+o",
    "File Tree: Git": "Alt+g",
    "File Tree: Unsaved": "Alt+u",
    "Terminal: Toggle": "Alt+t",
    "Find": "Ctrl+f",
    "Replace": "Ctrl+h",
    "Find Line": "Ctrl+g",
    "Find in Files": "Alt+F",
    "Change Working Directory": "Ctrl+o",
    "Go to Start of File": "Alt+{",
    "Go to End of File": "Alt+}",
    "Jump Back": "Alt+,",
    "Jump Forward": "Alt+.",
    "Close Buffer": "Ctrl+w",
    "Save": "Ctrl+s",
    "Quit": "Ctrl+q",
    "Undo": "Ctrl+z",
    "Redo": "Ctrl+y",
    "Cut": "Ctrl+x",
    "Copy": "Ctrl+c",
    "Paste": "Ctrl+v",
    "Select All": "Ctrl+a",
    "Toggle Comment": "Ctrl+/",
    "Change Indentation": "",
    "Set Language": "",
    "Set Theme": "",
    "LSP: Go to Definition": "Alt+d",
    "LSP: Hover": "Alt+s",
    "LSP: Rename Symbol": "Alt+r",
    "AI: Edit Selection": "Ctrl+k",
    "AI: Cancel Edits": "",
    "AI: Toggle Inline Completion": "",
    "Format Document": "",
    "Toggle Format on Save": "",
    "Toggle Trim Whitespace on Save": "",
    "Toggle Final Newline on Save": "",
    "Git: Toggle Diff View": "",
    "Git: Next Change": "Alt+'",
    "Git: Previous Change": "Alt+;",
    "Git: Revert Hunk": "Alt+z",
    "Git: Set Diff Base": "",
    "Git: Resolve Conflict": "Alt+m",
    "Toggle Line Wrap": "",
    "LSP: Next Diagnostic": "Alt+>",
    "LSP: Previous Diagnostic": "Alt+<",
    "LSP: Restart": "",
    "Debug: Inspect Tokens": "",
    "Debug: Message Log": "Alt+l",
    "Debug: Plugins": "",
    "File Tree: Delete": "Ctrl+d",
    "File Tree: Rename": "Ctrl+r",
    "File Tree: New": "Ctrl+n",
    "File Tree: Toggle Dotfiles": "Alt+.",
    "File Tree: Toggle Ignored": "Alt+i",
    "File Tree: Toggle Diff": "Alt+d",
    "File Tree: Restore File": "",
    "File Tree: Expand/Collapse All": "Alt+e"
  },
  "languages": {
    "odin": {
      "patterns": ["*.odin"],
      "lsp": "ols"
    },
    "c": {
      "patterns": ["*.c", "*.h"],
      "lsp": "clangd"
    },
    "cpp": {
      "patterns": ["*.cpp", "*.cc", "*.cxx", "*.hpp", "*.hh"],
      "lsp": "clangd"
    },
    "javascript": {
      "patterns": ["*.js", "*.mjs", "*.cjs"],
      "lsp": "typescript-language-server --stdio"
    },
    "jsx": {
      "patterns": ["*.jsx"],
      "lsp": "typescript-language-server --stdio"
    },
    "typescript": {
      "patterns": ["*.ts", "*.mts", "*.cts"],
      "lsp": "typescript-language-server --stdio"
    },
    "tsx": {
      "patterns": ["*.tsx"],
      "lsp": "typescript-language-server --stdio"
    },
    "python": {
      "patterns": ["*.py", "*.pyw"],
      "lsp": "pyright-langserver --stdio"
    },
    "go": {
      "patterns": ["*.go"],
      "lsp": "gopls"
    },
    "rust": {
      "patterns": ["*.rs"],
      "lsp": "rust-analyzer"
    },
    "shell": {
      "patterns": ["*.sh", "*.bash", "*.zsh", ".bashrc", ".bash_profile", ".bash_aliases", ".profile", ".zshrc", ".zshenv", ".zprofile", "PKGBUILD"],
      "lsp": "bash-language-server start"
    },
    "lua": {
      "patterns": ["*.lua", ".luacheckrc"],
      "lsp": "lua-language-server"
    },
    "sql": {
      "patterns": ["*.sql"],
      "lsp": ""
    },
    "yaml": {
      "patterns": ["*.yaml", "*.yml"],
      "lsp": "yaml-language-server --stdio"
    },
    "toml": {
      "patterns": ["*.toml"],
      "lsp": "taplo lsp stdio"
    },
    "dockerfile": {
      "patterns": ["Dockerfile", "*.dockerfile", "Dockerfile.*"],
      "lsp": "docker-langserver --stdio"
    },
    "json": {
      "patterns": ["*.json"],
      "lsp": ""
    },
    "html": {
      "patterns": ["*.html", "*.htm"],
      "lsp": "vscode-html-language-server --stdio"
    },
    "css": {
      "patterns": ["*.css"],
      "lsp": "vscode-css-language-server --stdio"
    },
    "markdown": {
      "patterns": ["*.md", "*.markdown"],
      "lsp": ""
    }
  }
}
